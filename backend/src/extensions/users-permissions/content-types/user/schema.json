{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "isApprovedByAdmin": {
      "type": "boolean",
      "default": false
    },
    "managerID": {
      "type": "string"
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "name": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "suburbs": {
      "type": "component",
      "repeatable": true,
      "component": "entry.suburb"
    },
    "age": {
      "type": "string"
    },
    "eyeColor": {
      "type": "string"
    },
    "height": {
      "type": "string"
    },
    "hairColor": {
      "type": "string"
    },
    "placeOfService": {
      "type": "string"
    },
    "selfies": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "coverPhoto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "phoneNumber": {
      "type": "string"
    },
    "contactInfo": {
      "type": "string"
    },
    "instagramLink": {
      "type": "string"
    },
    "onlyFansLink": {
      "type": "string"
    },
    "websiteLink": {
      "type": "string"
    },
    "aboutMe": {
      "type": "richtext"
    },
    "qualifications": {
      "type": "component",
      "repeatable": true,
      "component": "elements.text"
    },
    "experience": {
      "type": "component",
      "repeatable": true,
      "component": "elements.text"
    },
    "schedule": {
      "type": "component",
      "repeatable": true,
      "component": "elements.working-time"
    },
    "additionalInfo": {
      "type": "component",
      "repeatable": true,
      "component": "elements.text"
    },
    "reviews": {
      "type": "component",
      "repeatable": true,
      "component": "elements.review"
    },
    "favoriteProvidersIds": {
      "type": "component",
      "repeatable": true,
      "component": "elements.text"
    },
    "badge": {
      "type": "string"
    },
    "verificationStatus": {
      "displayName": "dataWithBooleanValues",
      "type": "component",
      "repeatable": false,
      "component": "entry.data-with-boolean-values"
    },
    "pendingData": {
      "type": "json"
    },
    "twitterLink": {
      "type": "string"
    },
    "otherLink": {
      "type": "string"
    },
    "availableNow": {
      "type": "boolean",
      "default": false
    },
    "digitalService": {
      "type": "string"
    },
    "managerProviderEmail": {
      "type": "string"
    },
    "services": {
      "displayName": "userData",
      "type": "component",
      "repeatable": false,
      "component": "elements.user-data"
    },
    "incall": {
      "type": "component",
      "repeatable": false,
      "component": "block.incall"
    },
    "outcall": {
      "type": "component",
      "repeatable": false,
      "component": "block.incall"
    }
  }
}
